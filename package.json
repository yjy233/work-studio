{
  "name": "work-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run test && npm run build",
    "test:agent": "tsx scripts/smoke-agent.ts",
    "format": "prettier --write src server tests scripts/smoke-agent.ts vite.config.ts",
    "postinstall": "node scripts/setup-pty.mjs",
    "practice:greedy": "tsx --test tests/greedy.test.ts",
    "practice:deepseek": "tsx --test tests/deepseek.test.ts",
    "practice:typescript": "tsx examples/typescript.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/dm-sans": "^5.3.0",
    "@openai/codex-sdk": "latest",
    "@uiw/react-codemirror": "^4.25.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "lucide-react": "latest",
    "node-pty": "^1.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.8",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "latest"
  }
}
